{
  "redirects": [
    {
      "source": "/library",
      "destination": "/coachmohamedzeina",
      "permanent": true
    },
    {
      "source": "/library/:path*",
      "destination": "/coachmohamedzeina/:path*",
      "permanent": true
    },
    {
      "source": "/library/index (2).html",
      "destination": "/coachmohamedzeina",
      "permanent": true
    },
    {
      "source": "/products/milga",
      "destination": "/products/b-complex",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/coachmohamedzeina",
      "destination": "/coachmohamedzeina/index.html"
    },
    {
      "source": "/coachmohamedzeina/:path*",
      "destination": "/coachmohamedzeina/index.html"
    },
    {
      "source": "/maqaam",
      "destination": "/api/maqaam"
    },
    {
      "source": "/maqaam/:studioPath*",
      "destination": "/api/maqaam?studioPath=:studioPath*"
    },
    {
      "source": "/egypt",
      "destination": "/index.html"
    },
    {
      "source": "/egypt/",
      "destination": "/index.html"
    },
    {
      "source": "/rwanda",
      "destination": "/index.html"
    },
    {
      "source": "/rwanda/",
      "destination": "/index.html"
    },
    {
      "source": "/global",
      "destination": "/index.html"
    },
    {
      "source": "/global/",
      "destination": "/index.html"
    },
    {
      "source": "/order",
      "destination": "/index.html"
    },
    {
      "source": "/order/",
      "destination": "/index.html"
    },
    {
      "source": "/benefits/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/explore",
      "destination": "/index.html"
    },
    {
      "source": "/products",
      "destination": "/index.html"
    },
    {
      "source": "/products/creatine/certificate",
      "destination": "/index.html"
    },
    {
      "source": "/products/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/knowledge",
      "destination": "/index.html"
    },
    {
      "source": "/knowledge/guides/:guideId",
      "destination": "/index.html"
    },
    {
      "source": "/knowledge/articles/:articleId",
      "destination": "/index.html"
    },
    {
      "source": "/analysis",
      "destination": "/index.html"
    },
    {
      "source": "/supplements",
      "destination": "/index.html"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/maqaam.js": {
      "includeFiles": "maqaam-runtime/**",
      "maxDuration": 60
    },
    "api/coach-portrait.js": {
      "includeFiles": "integration/coachmohamedzeina/portrait/**",
      "maxDuration": 10
    },
    "api/nutrition/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "integration/coachmohamedzeina/**"
    }
  }
}
